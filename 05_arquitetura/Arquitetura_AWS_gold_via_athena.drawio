<mxfile host="app.diagrams.net">
  <diagram name="Arquitetura AWS - Gold via Athena" id="goldathena1">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Arquitetura AWS — Pipeline State of Data Brasil (v2: Gold via Athena, sem camada Spark separada)" style="text;html=1;fontSize=15;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="1000" height="26" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Silver → Athena direto. O notebook Gold (state-of-data-gold-final-ver.ipynb) e as 7 tabelas saveAsTable saem do fluxo." style="text;html=1;fontSize=11;align=left;fontColor=#4A5568;" vertex="1" parent="1">
